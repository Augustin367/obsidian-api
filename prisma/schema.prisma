generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  clerkId   String?   @unique
  email     String    @unique
  name      String?
  role      Role      @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())

  title         String
  description   String?

  brand         ProductBrand?
  category      ProductCategory?
  family        String?
  model         String?
  
  color         String?
  ram           String?
  storage       String?

  imageUrl      String?
  images        String[] @default([])

  originalPrice Decimal  @db.Decimal(10,2)
  profit        Decimal  @default(0) @db.Decimal(10,2)
  salePrice     Decimal  @db.Decimal(10,2)

  sourceUrl     String
  sourceHash    String   @unique
  source        ProductSource

  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brand])
  @@index([source])
  @@index([family])
  @@index([category])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

enum ProductBrand {
  APPLE
  SAMSUNG
}

enum ProductCategory {
  TABLET
  NOTEBOOK
  HEADPHONE
  ACCESSORY
  SMARTPHONE
  SMARTWATCH
}

enum ProductSource {
  AMAZON
  SHOPEE
  MERCADOLIVRE
}